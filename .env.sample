# ═══════════════════════════════════════════════════════════
#  MicroClaw — .env sample
#  Copy to `.env` (repo root) or `dist/.env` (next to installer)
#  and fill in real values. `.env` is gitignored.
# ═══════════════════════════════════════════════════════════

# Model provider (OpenAI-compatible endpoint)
MODEL_BASE_URL=https://your-model-endpoint.example.com/v1
MODEL_API_KEY=sk-your-api-key-here
MODEL_NAME=claude-opus-4-6

# Optional: Brave Search API (https://brave.com/search/api/)
BRAVE_API_KEY=your-brave-api-key-here
