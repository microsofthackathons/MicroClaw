# ═══════════════════════════════════════════════════════════
#  OpenClaw Deployer — .gitignore
# ═══════════════════════════════════════════════════════════

# Secrets / environment
.env
.env.*
!.env.example
!.env.sample
dist/.env
# Legacy test file
litellm_auth_and_url.txt

# Runtime config (may contain user secrets)
config.yaml

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
*.egg

# Virtual environments
.venv/
venv/
ENV/

# PyInstaller build artifacts
build/
dist/
*.spec
!MicroClawDeployer.spec

# Bundled installers / large binaries
Dependency/

# Runtime-generated installer HTML (from webview_bridge.py)
deployer/assets/_installer.html

# Logs
logs/
build.log
setup.log

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
Desktop.ini
.DS_Store

nssm.exe

# Desktop (Electron + Vue)
desktop/node_modules/
desktop/renderer/node_modules/
desktop/dist/
desktop/renderer/dist/
desktop/release/
desktop/resources/
desktop/native/build/
desktop/studio-backend/data/
*.tsbuildinfo

# ESLint SARIF output (CI artifacts, not source)
*.sarif

# Claude (keep .claude/commands/ tracked for shared slash commands)
.claude/*
!.claude/commands/

# Debug logs
*-debug.log

# Root-level dev tool artifacts (esbuild etc.)
node_modules/

# Vitest coverage reports (generated by `vitest --coverage`)
coverage/

# ═══════════════════════════════════════════════════════════
docs/patent-application.md
