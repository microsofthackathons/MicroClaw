# Pin npm registry to npmmirror (China mirror).
#
# All packages we depend on are mirrored 1:1 from registry.npmjs.org with
# tarballs and metadata kept in sync. This avoids:
#   - Mixed `resolved` URLs across lockfiles (audited 2026-04-28: every
#     existing lockfile had a mix of npmjs.org and npmmirror.com depending
#     on which contributor's local ~/.npmrc was active when they ran
#     `npm install`).
#   - Slow / flaky CI on the self-hosted runner located in China.
#
# If npmmirror.com is ever unavailable, override locally with:
#     npm install --registry=https://registry.npmjs.org/
# or set `~/.npmrc` to point at the official registry.
registry=https://registry.npmmirror.com/
