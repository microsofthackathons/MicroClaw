# Product builds use deployer/assets/npm-registry.json. Set the process-scoped
# MICROCLAW_NPM_REGISTRY to select a deployment source, for example the corporate
# npm proxy https://packagefeedproxy.microsoft.io/npm/ on approved devices.
# Standalone developer npm commands retain the developer's own npm settings.
#
# Keep lockfiles registry-neutral so contributors can override the registry
# without npm following stale tarball URLs from a different registry.
omit-lockfile-registry-resolved=true
