# Pin npm registry to npmmirror (China mirror).
#
# Microsoft-managed devices can override this blocked public registry with:
#   setx NPM_CONFIG_REGISTRY https://packagefeedproxy.microsoft.io/npm/
#
# Keep lockfiles registry-neutral so contributors can override the registry
# without npm following stale tarball URLs from a different registry.
registry=https://registry.npmmirror.com/
omit-lockfile-registry-resolved=true
