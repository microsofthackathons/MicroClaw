<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="microclaw-public" value="https://packagefeedproxy.microsoft.io/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
