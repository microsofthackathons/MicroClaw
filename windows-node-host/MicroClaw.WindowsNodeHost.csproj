<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>microclaw-windows-node-host</AssemblyName>
    <RootNamespace>MicroClaw.WindowsNodeHost</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SelfContained)' == ''">
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference
      Include="..\third_party\openclaw-windows-node\source\src\OpenClaw.Shared\OpenClaw.Shared.csproj"
      AdditionalProperties="ImportDirectoryBuildProps=false;ImportDirectoryBuildTargets=false" />
    <InternalsVisibleTo Include="MicroClaw.WindowsNodeHost.Tests" />
  </ItemGroup>
</Project>
