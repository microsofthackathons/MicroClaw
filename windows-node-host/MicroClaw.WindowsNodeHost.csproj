<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>microclaw-windows-node-host</AssemblyName>
    <RootNamespace>MicroClaw.WindowsNodeHost</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SelfContained)' == ''">
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Mxc.Sdk" Version="1.0.1" />
    <ProjectReference
      Include="..\third_party\openclaw-windows-node\source\src\OpenClaw.Shared\OpenClaw.Shared.csproj"
      AdditionalProperties="ImportDirectoryBuildProps=false;ImportDirectoryBuildTargets=false;CustomAfterMicrosoftCommonTargets=$(MSBuildThisFileDirectory)OpenClaw.Shared.MicroClaw.targets;IntermediateOutputPath=$(MSBuildThisFileDirectory)obj\openclaw-shared\$(Configuration)\;OutputPath=$(MSBuildThisFileDirectory)bin\openclaw-shared\$(Configuration)\" />
    <InternalsVisibleTo Include="MicroClaw.WindowsNodeHost.Tests" />
  </ItemGroup>
  <ItemGroup Condition="'$(MicroClawFileWorkerManifest)' != ''">
    <EmbeddedResource Include="$(MicroClawFileWorkerManifest)">
      <LogicalName>OpenClaw.FileWorker.Manifest.$(RuntimeIdentifier)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="RequireFixedFileWorkerManifest" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(MicroClawFileWorkerManifest)' == '' or !Exists('$(MicroClawFileWorkerManifest)')"
      Text="Publish the Windows node through prepare-windows-node-resources.mjs so the upstream fixed file worker is included." />
  </Target>
</Project>
